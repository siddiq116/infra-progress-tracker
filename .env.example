# Neon Postgres — get these via `vercel env pull .env.local` once the Neon
# integration is connected in your Vercel project (Storage tab), or from
# your Neon project dashboard directly.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
PORT=5000

# Required for photo uploads (Vercel Dashboard -> Storage -> Blob -> .env.local tab)
BLOB_READ_WRITE_TOKEN=
